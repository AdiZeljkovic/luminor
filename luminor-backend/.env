# Luminor Backend Environment Variables

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MySQL)
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=luminor_db
DB_PORT=3306

# JWT Configuration
JWT_SECRET=luminor-secret-key-change-in-production-2024
JWT_REFRESH_SECRET=luminor-refresh-secret-key-change-in-production-2024
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# Email Configuration (for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@luminorsolution.com
EMAIL_TO=contact@luminorsolution.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000,http://127.0.0.1:3000
ADMIN_URL=http://localhost:3001,http://127.0.0.1:3001
