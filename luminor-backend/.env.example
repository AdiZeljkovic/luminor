# Luminor Backend Environment Variables
# Copy this file to .env and update values

# Server Configuration
PORT=5000
NODE_ENV=development
# Set to 'true' only if you want to allow public registration (NOT RECOMMENDED in production)
# Use scripts/createAdmin.js instead
ALLOW_REGISTRATION=false

# Database Configuration (MySQL/PostgreSQL)
DB_HOST=127.0.0.1
DB_USER=luminor
DB_PASS=your_password
DB_NAME=luminor
DB_DIALECT=mysql

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key-change-in-production
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

# CSRF Protection
CSRF_SECRET=your-csrf-secret-change-in-production

# Logging Configuration
# Set to 'true' to enable detailed request logging (access.log)
# WARNING: May impact performance in high-traffic production environments
LOG_REQUESTS=false

# Email Configuration (for contact form)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@luminorsolution.com
EMAIL_TO=contact@luminorsolution.com

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
